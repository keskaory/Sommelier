# copy to .env and fill in the keys. .env is gitignored.
# small model: llama 3.1 8b on groq's free tier
SMALL_BASE_URL=https://api.groq.com/openai/v1
SMALL_MODEL=llama-3.1-8b-instant
SMALL_API_KEY=
SMALL_RPM=25

# large model: llama 3.3 70b on cerebras's free tier. check the model id, cerebras renames them.
LARGE_BASE_URL=https://api.cerebras.ai/v1
LARGE_MODEL=llama-3.3-70b
LARGE_API_KEY=
LARGE_RPM=25

# to try the pipeline locally with ollama instead, point either one at it:
# SMALL_BASE_URL=http://localhost:11434/v1
# SMALL_MODEL=llama3.2
