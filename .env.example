# copy to .env and fill in the key. .env is gitignored.
# both models are gemma 4 on google ai studio's free tier, one key works for both.
# small = 26b mixture-of-experts with ~4b active per token, large = 31b dense.
# check the model ids in ai studio, google renames them. 15k tokens/min ~ 10 calls/min.
SMALL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SMALL_MODEL=gemma-4-26b-a4b-it
SMALL_API_KEY=
SMALL_RPM=10

LARGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LARGE_MODEL=gemma-4-31b-it
LARGE_API_KEY=
LARGE_RPM=10

# to try the pipeline locally with ollama instead, point either one at it:
# SMALL_BASE_URL=http://localhost:11434/v1
# SMALL_MODEL=gemma3:4b
